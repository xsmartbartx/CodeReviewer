# Public URL of the web app, without a trailing slash. GitHub and Stripe call back here.
APP_URL=http://localhost:3000

# PostgreSQL. docker-compose.yml overrides this for its bundled database.
DATABASE_URL=postgres://codereviewer:codereviewer@localhost:5432/codereviewer

# GitHub App. `npm run github-app:create -- --url <APP_URL>` creates one and prints these.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The PEM private key on one line with \n for newlines, or the multi-line PEM in quotes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic API key used by the worker.
ANTHROPIC_API_KEY=
# Model and reasoning effort for reviews. Lower effort or a smaller model costs less per review.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Stripe billing. Leave all four empty to run without billing (unlimited reviews).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Reviews processed in parallel per worker process.
WORKER_CONCURRENCY=3

# Shown on the legal and docs pages. SUPPORT_EMAIL defaults to support@<APP_URL host>.
COMPANY_NAME=CodeReviewer
SUPPORT_EMAIL=
