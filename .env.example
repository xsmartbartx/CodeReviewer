# Public URL of the web app, without a trailing slash. GitHub and Stripe call back here.
APP_URL=http://localhost:3000

# PostgreSQL. docker-compose.yml overrides this for its bundled database.
DATABASE_URL=postgres://codereviewer:codereviewer@localhost:5432/codereviewer

# GitHub App. `npm run github-app:create -- --url <APP_URL>` creates one and prints these.
# Optional at first launch: until all six are set, sign-in, webhooks, and reviews stay off.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The PEM private key on one line with \n for newlines, or the multi-line PEM in quotes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic API key used by the worker.
ANTHROPIC_API_KEY=
# Model and reasoning effort for reviews. Lower effort or a smaller model costs less per review.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Stripe billing. Leave all four empty to run without billing (unlimited reviews).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# NEXORA Core billing (docs/nexora-integration.md). Only for the instance hosted on NEXORA:
# the secret is shared with Core's CODEREVIEWER_SYNC_SECRET. Leave empty to keep it off.
NEXORA_SYNC_SECRET=
NEXORA_CONSOLE_URL=https://console.onenexora.com

# NEXORA sign-in (Clerk, the instance the other NEXORA apps use). Leave both keys empty to keep
# GitHub as the only sign-in. GITHUB_SIGNIN=off hides GitHub sign-in (linking still uses it).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXORA_ACCOUNT_URL=https://account.onenexora.com
GITHUB_SIGNIN=on

# Reviews processed in parallel per worker process.
WORKER_CONCURRENCY=3

# Shown on the legal and docs pages. SUPPORT_EMAIL defaults to support@<APP_URL host>.
COMPANY_NAME=CodeReviewer
SUPPORT_EMAIL=
