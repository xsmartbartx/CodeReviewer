{
  "name": "codereviewer",
  "version": "1.0.0",
  "private": true,
  "description": "AI pull request reviews for GitHub, powered by Claude.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/index.ts src/db/migrate.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "next start",
    "start:worker": "node dist/worker/index.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "github-app:create": "node scripts/create-github-app.mjs",
    "smoke:review": "tsx scripts/smoke-review.ts",
    "schema:generate": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@clerk/nextjs": "^7.9.22",
    "@octokit/webhooks-methods": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.4",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "picomatch": "^4.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "^23.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.0",
    "@types/picomatch": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
